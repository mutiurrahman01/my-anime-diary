
# Supabase configuration
# Required for all Supabase client and server actions
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for server-side admin operations (like deleting accounts)
# DO NOT expose this key to the client!
SUPABASE_SERVICE_ROLE_KEY=

#Add URL of your site here, for example: https://my-anime-diary.vercel.app
NEXT_PUBLIC_SITE_URL=